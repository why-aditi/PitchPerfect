# Platform-level only. Per-agent integration credentials live in the database (PRD 17).

AGORA_APP_ID=            AGORA_APP_CERTIFICATE=     # token generation
AGORA_CUSTOMER_ID=       AGORA_CUSTOMER_SECRET=     # Basic auth for the engine REST API
AGORA_AREA=US                                       # US | EU | AP | CN, routes the engine SDK
MISTRAL_API_KEY=                                    # default provider
# Any OpenAI-compatible /chat/completions endpoint. Set both to move off Groq — whose free
# tier is 8000 tokens/minute, about four turns of a live call. Mistral's free tier is 500k.
#   LLM_URL=https://api.mistral.ai/v1/chat/completions
#   LLM_API_KEY=                                    # and set llm_model on the agent
LLM_URL=                 LLM_API_KEY=
# Second provider, tried once when the primary returns a 429 whose wait is longer than
# the ~5s a live turn can hold. Unset LLM_FALLBACK_URL and there is no fallback and no
# extra latency. Only worth setting to a provider that actually has quota — the Mistral
# key here reported 0 requests/minute, and a second dead provider just adds a hop.
#   LLM_FALLBACK_URL=https://api.mistral.ai/v1/chat/completions
#   LLM_FALLBACK_API_KEY=                           # falls back to LLM_API_KEY if unset
#   LLM_FALLBACK_MODEL=mistral-small-latest         # must be an id THIS provider serves
LLM_FALLBACK_URL=        LLM_FALLBACK_API_KEY=      LLM_FALLBACK_MODEL=
LLM_PROXY_SECRET=                                   # matches properties.llm.api_key

DATABASE_URL=                                       # Postgres, free tier
CONSOLE_PASSWORD=                                   # single operator login
CONSOLE_SESSION_SECRET=                             # signs the console cookie
CONSOLE_URL=http://localhost:3001                   # where the embed iframe points
PUBLIC_BASE_URL=http://localhost:8000               # tunnel; the engine calls this

# Seed-time only. `python -m backend.seed` copies these onto ag_demo's database secrets so
# a fresh clone books a real meeting and writes a real deal; nothing reads them at call time.
CAL_API_KEY=             CAL_EVENT_TYPE_ID=         # Cal.com, or paste them in the console
HUBSPOT_TOKEN=                                      # private app token, pat-na1-...
NOTION_TOKEN=                                       # internal integration secret, ntn_...
# Database ids as they appear in the Notion URL. Optional, and independent: leads mirrors
# the CRM write during a call, pricing is only read by the console's import button. The
# integration must be shared with each database in Notion — the token alone is not access.
NOTION_LEADS_DB=         NOTION_PRICING_DB=

# Dev only. schema.sql is idempotent and re-runs whenever the pool is created — 380 ms,
# paid on every restart. `python -m backend.seed` applies it, so once the tables exist
# this is pure startup cost. Leave unset anywhere the schema might not be applied yet.
SKIP_SCHEMA_ON_CONNECT=
